{
  "name": "bdc-warband-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial fan-made warband builder and campaign tracker for Black Death City (playtest v1.03).",
  "author": "Adrien Duclaud",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:data": "tsx scripts/check-data.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:data && npm run check:i18n && npm run test",
    "build:glossary": "tsx scripts/build-glossary.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "i18next": "26.4.4",
    "i18next-browser-languagedetector": "8.2.1",
    "lz-string": "1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-window": "7.4.1"
  }
}
